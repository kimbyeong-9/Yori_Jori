DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55432/yorijori_test

# Gemini API (4단계 — 추천 로직)
# 실제 키는 .env(커밋 안 함)에만 넣는다. 로그/에러 메시지에 절대 노출하지 않는다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=25

# 배포 환경에서 프론트(Vercel) 도메인을 CORS 허용 목록에 추가한다. 콤마로 여러 개 구분.
# 로컬 개발은 vite 프록시로 동일 출처처럼 동작해 기본값(localhost:5173)이면 충분하다.
CORS_ORIGINS=http://localhost:5173,https://yori-jori-psi.vercel.app
